# ═══════════════════════════════════════════════════════════
# AI Girlfriend — FastAPI Backend Systemd Service Unit
# ═══════════════════════════════════════════════════════════
# Deploy to: /etc/systemd/system/ai-girlfriend-backend.service
# Then: systemctl daemon-reload
#       systemctl enable ai-girlfriend-backend
#       systemctl start ai-girlfriend-backend
# ═══════════════════════════════════════════════════════════

[Unit]
Description=AI Girlfriend FastAPI Backend
Documentation=https://github.com/fourteen-ai/ai-girlfriend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ai-girlfriend

# ── ExecStart ──────────────────────────────────────────────
# Workers = 4 for a typical 2-4 vCPU production server
# Adjust --workers to match your CPU core count
ExecStart=/opt/ai-girlfriend/.venv/bin/uvicorn api.run_api:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --log-level info \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1"

# ── Environment ───────────────────────────────────────────
Environment=PYTHONPATH=/opt/ai-girlfriend
EnvironmentFile=/opt/ai-girlfriend/.env

# ── Restart Policy ────────────────────────────────────────
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=30

# ── Resource Limits ───────────────────────────────────────
LimitNOFILE=65536
LimitNPROC=4096

# ── Sandboxing / Security ─────────────────────────────────
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=

# Writeable paths (needed for logs, cache, data)
ReadWritePaths=/opt/ai-girlfriend/data /opt/ai-girlfriend/cache /opt/ai-girlfriend/logs

[Install]
WantedBy=multi-user.target
