# ═══════════════════════════════════════════════════════════
# 唯一的你 — FastAPI Backend Systemd Service Unit
# ═══════════════════════════════════════════════════════════
# Deploy to: /etc/systemd/system/unique-you-backend.service
# Then: systemctl daemon-reload
#       systemctl enable unique-you-backend
#       systemctl start unique-you-backend
# ═══════════════════════════════════════════════════════════

[Unit]
Description=唯一的你 FastAPI Backend
Documentation=https://github.com/fourteen-ai/unique-you
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/unique-you

# ── ExecStart ──────────────────────────────────────────────
# Workers = 4 for a typical 2-4 vCPU production server
# Adjust --workers to match your CPU core count
ExecStart=/opt/unique-you/.venv/bin/uvicorn api.run_api:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --log-level info \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1"

# ── Environment ───────────────────────────────────────────
Environment=PYTHONPATH=/opt/unique-you
EnvironmentFile=/opt/unique-you/.env

# ── Restart Policy ────────────────────────────────────────
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=30

# ── Resource Limits ───────────────────────────────────────
LimitNOFILE=65536
LimitNPROC=4096

# ── Sandboxing / Security ─────────────────────────────────
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=

# Writeable paths (needed for logs, cache, data)
ReadWritePaths=/opt/unique-you/data /opt/unique-you/cache /opt/unique-you/logs

[Install]
WantedBy=multi-user.target
