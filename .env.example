# ═══════════════════════════════════════════════
# AI-Girlfriend 环境配置示例
# 复制为 .env 并按需修改
# ═══════════════════════════════════════════════

# ── LLM 供应商模式 ──
# "auto" = MultiProviderGateway（多供应商自动fallback，推荐）
# 可选单供应商: zhipu / xunfei / baidu / deepseek / opencode_zen
LLM_PROVIDER=auto

# ── 智谱AI GLM-4.7-Flash（永久免费，无Token上限）──
# 注册: https://open.bigmodel.cn/
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# ── 讯飞星火 Spark Lite（永久免费，Token无限）──
# 注册: https://xinghuo.xfyun.cn/
# XUNFEI_API_KEY=your-xunfei-api-key
# XUNFEI_API_BASE=https://spark-api-open.xf-yun.com/v1
# XUNFEI_MODEL=spark-lite

# ── 百度千帆 ERNIE-Speed（每月50万Token免费）──
# 注册: https://cloud.baidu.com/product/wenxinworkshop
# BAIDU_API_KEY=your-baidu-api-key
# BAIDU_API_BASE=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat
# BAIDU_MODEL=ernie-speed-128k

# ── DeepSeek（高质量推荐，需自行申请 API Key）──
# 申请: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ── OpenCode Zen 免费大模型（无需 API Key，兜底方案）──
# OPENCODE_ZEN_DEFAULT_MODEL=big-pickle
# OPENCODE_ZEN_API_BASE=https://opencode.ai/zen/v1

# ── 商汤日日新 SenseNova（强力模型 glm-5.2，1M上下文）──
# 申请: https://platform.sensenova.cn/
# SENSENOVA_API_KEY=sk-your-sensenova-key
# SENSENOVA_API_BASE=https://token.sensenova.cn/v1
# SENSENOVA_MODEL=glm-5.2

# ── 环境配置 ──
AI_GF_ENV=dev                     # dev / prod / test

# ── API 安全配置 ──
# ⚠️ 生产环境必须启用 API_KEY_ENABLED=true 并设置强密码
API_KEY=CHANGE_ME_TO_STRONG_RANDOM_KEY_32_CHARS_MIN
API_KEY_ENABLED=true              # 生产环境必须设为 true
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── 可选配置 ──
# LOG_LEVEL=INFO
