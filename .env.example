# ═══════════════════════════════════════════════
# AI-Girlfriend 环境配置示例
# 复制为 .env 并按需修改
# ═══════════════════════════════════════════════

# ── LLM 供应商模式 ──
# "auto" = MultiProviderGateway（多供应商自动fallback，推荐）
# 可选单供应商: agnes / zhipu / xunfei / baidu / deepseek
LLM_PROVIDER=auto

# ── 智谱AI GLM-4.5-Flash（免费档，链上第 2 位降级选项）──
# 注册: https://open.bigmodel.cn/
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 档位说明（2026-09-21 逐模型实调，勿凭空改档）：
#   glm-4.7 / glm-4.5-air → 1113「余额不足或无可用资源包」= 付费档，免费 key 用不了
#   glm-4.7-flash         → 1305「该模型当前访问量过大」= 免费池拥挤，不可依赖
#   glm-4.5-flash         → 可用，但**默认开思考**：小 max_tokens 下 content 为空/半句，
#                           必须保留 config/llm_providers.json 的 thinking=disabled
#   glm-4-flash           → 可用，角色扮演对齐最弱（裸提示下自称「人工智能助手」），已弃用
# ZHIPU_MODEL=glm-4.5-flash

# ── 讯飞星火 Spark Lite（永久免费，Token无限）──
# 注册: https://xinghuo.xfyun.cn/
# XUNFEI_API_KEY=your-xunfei-api-key
# XUNFEI_API_BASE=https://spark-api-open.xf-yun.com/v1
# XUNFEI_MODEL=spark-lite

# ── 百度千帆 ERNIE-Speed（每月50万Token免费）──
# 注册: https://cloud.baidu.com/product/wenxinworkshop
# BAIDU_API_KEY=your-baidu-api-key
# BAIDU_API_BASE=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat
# BAIDU_MODEL=ernie-speed-128k

# ── DeepSeek（高质量推荐，需自行申请 API Key）──
# 申请: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ── Agnes AI（agnes-3.0-flash，OpenAI 兼容，默认首选）──
# 申请: https://apihub.agnes-ai.com
# AGNES_API_KEY=sk-your-agnes-key
# AGNES_API_BASE=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash

# ── 环境配置 ──
# 检测优先级：AI_GF_ENV > APP_ENV > ENV（api/runtime_config.py 真源）
# 仅当显式为 dev/development 时，JWT 才允许使用公开 DEV 兜底密钥；
# 生产必须设为 prod/production，并配置 JWT_SECRET + 强随机 API_KEY。
# 可选值：dev / prod / test
AI_GF_ENV=dev

# ── JWT（非显式 dev 必填）──
# 生成: openssl rand -base64 48
# 未设置且 AI_GF_ENV/APP_ENV/ENV 不是 dev/development 时，进程拒绝启动（fail-closed）。
# JWT_SECRET=

# ── API 安全配置 ──
# ⚠️ 以下占位符是公开的、不可用于生产。
# 生产或 API_KEY_ENABLED=true 且非显式 dev 时，启动会 fail-closed 拒绝占位符。
# 生成强密钥: openssl rand -base64 32
API_KEY=REPLACE_ME_WITH_RANDOM_32_PLUS_CHAR_SECRET
# 生产环境必须设为 true
API_KEY_ENABLED=true
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── 小米 MiMo 语音（唯一 TTS 引擎，config/system.yaml 的 ${MIMO_API_KEY}）──
# 申请: https://platform.xiaomimimo.com/
# 语音合成 / 音色克隆 / 音色设计共用同一 key；真实值只放 .env（已 gitignore），
# 勿写入 git-tracked 的 config/system.yaml。
# MIMO_API_KEY=sk-your-mimo-key

# ── 风格提取（克隆）数据集 ──
# 单个用户最多可保存的数据集数量（默认 20）。
# 非数字或 <=0 的脏值一律回落默认值；超限的上传返回 429。
# CLONE_MAX_DATASETS_PER_USER=20

# ── 影子账本 / 主动线上收开关（2026-11-11 B-2）──
# AGENT_CORE_EVENTS: 会话级影子账本（agent_events / agent_threads / agent_commitments）。
# SPEAKER_PROACTIVE: 主动线承诺闸 —— **真实挡板**，每次 tick 现读，控制主动线
#   是否「登记承诺 / 未兑现承诺进决策上下文 / 禁止作为 hooks 由头复提 / 用户回执
#   即销账」。置 0 = 这四件事全停（承诺闸回旧路径），无需重启即生效下一拍。
# 校验视图把缺省视为 1（开）；但账本运行期是「未写入即零写入」，请显式写 1。
# 两者同时置 0 = 完整回旧路径（不建表、不读写账本、不做承诺闸）。
# ⚠️ speaker on 且 ledger off 会在启动期**自动降级**（返回双 0）并记
#    ERROR: speaker_auto_disabled:ledger_off —— 账本关着时上收拿不到承诺真源，
#    只会上收一半，故宁可整条回旧路径。判定与消费的**唯一 owner**：
#    utils/speaker_switches.py（orchestrator 与 api 两个入口打印生效值；
#    proactive/scheduler.py 的承诺闸读 speaker_proactive_enabled()）。
AGENT_CORE_EVENTS=1
SPEAKER_PROACTIVE=1
# SPEAKER_REPLY: B-3 主链拆条新语义（hard_limit + max_segments=1 可选）。置 0
#   逐字回 2026-11-11 之前的拆条行为（一行回滚）。
# SPEAKER_REMINDER: B-4 提醒线人设前缀（提醒线与日期线共用同一人设源）。置 0
#   回旧 generic 提醒提示词；提醒投递保证与失败回落不受影响。
# PROACTIVE_VOICE_VIA_PLANE: D1 主动语音走跨 worker 控制面（连接器宿主合成+
#   peer 锁内投递）。置 0 回旧直发路径（本进程找凭据→合成→发文件卡片）。
SPEAKER_REPLY=1
SPEAKER_REMINDER=1
PROACTIVE_VOICE_VIA_PLANE=1

# ── 可选配置 ──
# LOG_LEVEL=INFO

# ── 供应商密钥落盘说明 ──
# 管理控制台保存的 LLM api_key 只写入 config/llm_providers.local.json（已 gitignore），
# 不会写入 git-tracked 的 config/llm_providers.json。也可只使用上方 * _API_KEY 环境变量。