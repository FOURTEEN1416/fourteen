# ── LLM 提供商：OpenCode Zen 免费大模型（默认，无需 API Key） ──
LLM_PROVIDER=opencode_zen
OPENCODE_ZEN_DEFAULT_MODEL=big-pickle      # 可选：nemotron-3-super-free / qwen3.6-plus-free / deepseek-v4-flash-free / minimax-m2.5-free
OPENCODE_ZEN_API_BASE=https://opencode.ai/zen/v1

# ── 环境配置 ──
AI_GF_ENV=dev                     # dev / prod / test

# ── API配置 ──
API_KEY=your-api-key-for-frontend
API_KEY_ENABLED=false             # 生产环境设为true
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── 可选配置 ──
# LOG_LEVEL=INFO

# ── 微信连接：使用 wechat_direct 直连方案（无需 CowAgent） ──
