# 唯一的你·十四 - 前端环境变量
# 复制此文件为 .env 并根据需要修改

# === 安全配置 ===
# 注意: .env 文件包含敏感信息，不应提交到版本控制
# 生产环境请确保:
# 1. 配置 HTTPS (通过 Nginx + certbot)
# 2. 设置强随机 API Key (至少 32 字符)
# 3. 启用后端加密 (encryption_enabled: true)
# 4. 禁用调试模式 (debug: false)

# Vite 开发服务器端口（默认 5173）
VITE_DEV_PORT=5173

# API 地址（开发环境通过 Vite proxy 转发，无需修改）
VITE_API_BASE=http://localhost:8000

# WebSocket 地址（默认 :8765，部署时修改）
VITE_WS_URL=ws://localhost:8765
